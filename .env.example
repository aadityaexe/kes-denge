# MARK2 — Environment Template (.env.example)
# Copy to .env.local and fill in your values. Never commit .env.local.

# Application Public URL (canonical URLs, OpenGraph, sitemaps, robots)
NEXT_PUBLIC_APP_URL=https://www.mark2.in

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT Secret Key for Admin Session (minimum 32 chars)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars

# Cloudinary Media Storage (required in production; or use CLOUDINARY_URL)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Optional: Upstash Redis rate limiting (falls back to MongoDB)
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your-token>

# Optional: Contact form email notifications via Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=MARK2 <noreply@mark2.in>
# CONTACT_NOTIFICATION_EMAIL=hello@mark2.in

# Optional: Cloudflare Turnstile & trusted proxy header handling
# TURNSTILE_SECRET_KEY=
# TRUSTED_PROXY=false
