# ============================================================
# MARK TECHNOLOGIES — ENVIRONMENT TEMPLATE (.env.example)
# ============================================================

# 1. Application Public URL (used for canonical URLs, OpenGraph, sitemaps, and robots)
NEXT_PUBLIC_APP_URL=https://www.mark2.in

# 2. MongoDB Database Connection String (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# 3. JWT Secret Key for Admin Authentication Session (Minimum 32 characters random string)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars

# 4. Cloudinary Image & Media Storage
# REQUIRED IN PRODUCTION. Vercel's filesystem is ephemeral — files written to
# /public/uploads do not persist between deployments or across function instances.
# Without Cloudinary configured, the upload API will return a 503 in production.
# Sign up for a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, use a single connection URL:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# 5. Node Environment
NODE_ENV=development
